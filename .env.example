# All variables are optional and are read at BUILD time (Vite). Never put secrets here:
# everything prefixed VITE_ ends up in the public JavaScript bundle.

# Contact address shown on /contact and in the privacy policy.
VITE_CONTACT_EMAIL=

# Google AdSense (leave empty to disable ads entirely — the default).
# Publisher ID, e.g. ca-pub-0000000000000000
VITE_ADSENSE_CLIENT=
# Placement -> ad unit slot ID, comma-separated. Allowed placements:
# home-below-hero, home-between-sections, templates-gallery, guide-article, guides-index, landing-content
VITE_ADSENSE_SLOTS=

# Optional content-free analytics beacon endpoint (also add its origin to connect-src in public/_headers).
VITE_ANALYTICS_ENDPOINT=

# Test builds only: show labeled ad placeholders in a production build.
VITE_AD_PLACEHOLDERS=
